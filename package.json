{
  "name": "@tesronae/ui",
  "version": "0.1.3",
  "private": false,
  "description": "Reusable design system: tokens, components, motion. Ships TypeScript source directly \u2014 consuming apps compile it with their own bundler (Next.js: add to transpilePackages).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./design/tokens/tokens.json",
    "./DataTable.module.css": "./src/components/ui/DataTable.module.css"
  },
  "files": [
    "src",
    "dist",
    "design/tokens/tokens.json",
    "design/docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint && stylelint \"src/**/*.module.css\"",
    "test": "vitest run",
    "build:tokens": "style-dictionary build --config design/tokens/style-dictionary.config.mjs",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "verify:packed": "node scripts/verify-packed-consumer.mjs",
    "prepublishOnly": "npm run build:tokens"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {},
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-storybook": "^10.6.0",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.3",
    "stylelint": "^17.15.0",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "5.0.0",
    "@types/node": "^22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tesronae/ui.git"
  }
}